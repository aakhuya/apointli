# ─────────────────────────────────────────
# Apointli Backend — Environment Variables
# ─────────────────────────────────────────

# Application
APP_NAME=Apointli
ENVIRONMENT=development
DEBUG=true
PORT=3001

# Security — CHANGE THESE IN PRODUCTION
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated list of allowed origins
CORS_ORIGINS_RAW=http://localhost:3002,http://localhost:3000

# Database — PostgreSQL connection string
# Local: postgresql+asyncpg://apointli:apointli123@localhost:5432/apointli
# Render: postgresql+asyncpg://user:pass@host/db (Render sets this)
DATABASE_URL=postgresql+asyncpg://apointli:apointli123@localhost:5432/apointli

# Redis — Celery broker + cache
# Local: redis://localhost:6379/0
# Upstash/Render: rediss://... (SSL) for production
REDIS_URL=redis://localhost:6379/0

# Email — Resend
# Leave empty in dev to log emails to console instead of sending
RESEND_API_KEY=
EMAIL_FROM=apointli <onboarding@resend.dev>

# Frontend base URL — used in email links
APP_BASE_URL=http://localhost:3002
